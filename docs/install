#!/bin/sh
# Plaintext installer: curl -fsSL https://getplaintext.org/install | sh
# Puts the latest `plaintext` command line in ~/.plaintext/bin (or $PLAINTEXT_INSTALL_DIR) and adds that to your PATH.
set -eu

repo=backmeupplz/plaintext
case "$(uname -s)/$(uname -m)" in
  Darwin/arm64) target=aarch64-apple-darwin ;;
  Darwin/x86_64) target=x86_64-apple-darwin ;;
  Linux/x86_64 | Linux/amd64) target=x86_64-unknown-linux-musl ;;
  Linux/aarch64 | Linux/arm64) target=aarch64-unknown-linux-musl ;;
  *)
    echo "Plaintext has no prebuilt binary for $(uname -s) $(uname -m) yet." >&2
    echo "On Windows, download plaintext-x86_64-pc-windows-gnu.zip from https://github.com/$repo/releases/latest" >&2
    echo "Anywhere else, build it from source: cargo install --git https://github.com/$repo plaintext-cli" >&2
    exit 1
    ;;
esac

dir="${PLAINTEXT_INSTALL_DIR:-$HOME/.plaintext/bin}"
mkdir -p "$dir"
base="https://github.com/$repo/releases/latest/download"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
echo "downloading $base/plaintext-$target.tar.gz"
curl -fsSL -o "$tmp/plaintext-$target.tar.gz" "$base/plaintext-$target.tar.gz"
# the release's SHA256SUMS: a download that doesn't match it never gets unpacked
curl -fsSL -o "$tmp/SHA256SUMS" "$base/SHA256SUMS"
if command -v sha256sum >/dev/null 2>&1; then sum="sha256sum"; else sum="shasum -a 256"; fi
# compared by hand: some sha256sum -c pass on empty input, so a missing line would skip the check
want="$(grep " plaintext-$target.tar.gz\$" "$tmp/SHA256SUMS" | cut -d' ' -f1)"
got="$($sum "$tmp/plaintext-$target.tar.gz" | cut -d' ' -f1)"
[ -n "$want" ] && [ "$want" = "$got" ] || {
  echo "plaintext-$target.tar.gz doesn't match the release's SHA256SUMS, so nothing was installed" >&2
  exit 1
}
tar -xzf "$tmp/plaintext-$target.tar.gz" -C "$tmp" plaintext
chmod +x "$tmp/plaintext"
mv "$tmp/plaintext" "$dir/plaintext"
echo "installed $("$dir/plaintext" --version) to $dir/plaintext"

case ":$PATH:" in
  *":$dir:"*) exit 0 ;;
esac
line="export PATH=\"$dir:\$PATH\""
case "${SHELL:-}" in
  */zsh) rc="$HOME/.zshrc" ;;
  */bash) if [ "$(uname -s)" = Darwin ]; then rc="$HOME/.bash_profile"; else rc="$HOME/.bashrc"; fi ;;
  */fish)
    rc=""
    mkdir -p "$HOME/.config/fish/conf.d"
    echo "fish_add_path $dir" > "$HOME/.config/fish/conf.d/plaintext.fish"
    ;;
  *) rc="$HOME/.profile" ;;
esac
if [ -n "$rc" ] && ! grep -qsF "$line" "$rc"; then
  printf '\n# plaintext\n%s\n' "$line" >> "$rc"
  echo "added $dir to PATH in $rc"
fi
echo "open a new terminal (or run: $line), then try: plaintext --help"
